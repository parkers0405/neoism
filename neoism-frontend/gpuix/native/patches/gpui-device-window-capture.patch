+    /// Captures a complete scene with this renderer's device, atlas and current viewport.
+    /// Allocates readback resources only on request; never acquires or presents a drawable.
+    pub fn render_scene_to_pixels(&mut self, scene: &Scene) -> Result<gpui::RgbaImage> {
+        let width = self.surface_config.width;
+        let height = self.surface_config.height;
+        anyhow::ensure!(
+            width > 0 && height > 0 && width <= 4096 && height <= 4096,
+            "capture dimensions must be within 1..=4096, got {width}x{height}"
+        );
+        let mut pixels = vec![0; width as usize * height as usize * 4];
+        self.read_scene_to_pixels(scene, width, height, &mut pixels)?;
+        gpui::RgbaImage::from_raw(width, height, pixels).context("invalid capture dimensions")
+    }
+
+    fn read_scene_to_pixels(
+        &mut self,
+        scene: &Scene,
+        width: u32,
+        height: u32,
+        pixels: &mut [u8],
+    ) -> Result<()> {
+        anyhow::ensure!(!self.device_lost(), "the GPU device was lost");
+        let format = self.surface_config.format;
+        anyhow::ensure!(
+            matches!(format, wgpu::TextureFormat::Rgba8Unorm | wgpu::TextureFormat::Rgba8UnormSrgb
+                | wgpu::TextureFormat::Bgra8Unorm | wgpu::TextureFormat::Bgra8UnormSrgb),
+            "unsupported capture format: {format:?}"
+        );
+        let unpadded_bytes_per_row = width * 4;
         self.atlas.before_frame();
         self.ensure_intermediate_textures();
         self.ensure_readback(width, height);
