--- c/crates/gpui_linux/src/gpui_linux.rs
+++ w/crates/gpui_linux/src/gpui_linux.rs
@@ -2,3 +2,14 @@
 mod linux;
 
 pub use linux::current_platform;
+
+static PRESENTED_SAMPLE: std::sync::Mutex<(u64, u64)> = std::sync::Mutex::new((0, 0));
+
+pub(crate) fn record_presentation(time_ns: u64) {
+    if let Ok(mut sample) = PRESENTED_SAMPLE.lock() { sample.0 += 1; sample.1 = time_ns; }
+}
+
+/// Compositor-confirmed frame count and timestamp in nanoseconds, if available.
+pub fn presented_frame_sample() -> Option<(u64, u64)> {
+    PRESENTED_SAMPLE.lock().ok().and_then(|sample| (sample.0 > 0).then_some(*sample))
+}
