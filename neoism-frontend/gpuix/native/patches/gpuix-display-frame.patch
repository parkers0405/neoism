+// Opt-in phase measurements for the retained-tree bridge. Never inspect
+// commands or document contents, and never read a clock when disabled.
+static TREE_PROFILE_ENABLED: std::sync::LazyLock<bool> = std::sync::LazyLock::new(|| {
+    std::env::var("NEOISM_GPUIX_TREE_PROFILE").as_deref() == Ok("1")
+});
+
+#[derive(Clone, Copy, Default)]
+struct TreeProfileMetric {
+    count: u64,
+    sum_us: f64,
+    max_us: f64,
+}
+
+struct TreeProfile {
+    since: std::time::Instant,
+    metrics: [TreeProfileMetric; 5],
+}
+
+static TREE_PROFILE: std::sync::LazyLock<Mutex<TreeProfile>> = std::sync::LazyLock::new(|| {
+    Mutex::new(TreeProfile {
+        since: std::time::Instant::now(),
+        metrics: [TreeProfileMetric::default(); 5],
+    })
+});
+
+fn tree_profile_now() -> Option<std::time::Instant> {
+    (*TREE_PROFILE_ENABLED).then(std::time::Instant::now)
+}
+
+fn record_tree_profile(samples: &[(usize, Duration)]) {
+    let now = std::time::Instant::now();
+    let report = {
+        let mut profile = TREE_PROFILE.lock().unwrap();
+        for &(index, elapsed) in samples {
+            let metric = &mut profile.metrics[index];
+            let us = elapsed.as_secs_f64() * 1_000_000.0;
+            metric.count += 1;
+            metric.sum_us += us;
+            metric.max_us = metric.max_us.max(us);
+        }
+        let elapsed = now.saturating_duration_since(profile.since);
+        if elapsed >= Duration::from_secs(1) {
+            let metrics = std::mem::replace(&mut profile.metrics, [TreeProfileMetric::default(); 5]);
+            profile.since = now;
+            Some((elapsed, metrics))
+        } else {
+            None
+        }
+    };
+    if let Some((elapsed, metrics)) = report {
+        let names = ["root_lock_wait", "sync_prune", "host_build", "root_render", "batch_lock_wait"];
+        let values: serde_json::Map<String, serde_json::Value> = names.into_iter().zip(metrics)
+            .map(|(name, metric)| (name.to_owned(), serde_json::json!({
+                "count": metric.count, "sum_us": metric.sum_us, "max_us": metric.max_us,
+            }))).collect();
+        eprintln!("[neoism-gpuix-tree-profile] {}", serde_json::json!({
+            "elapsed_ms": elapsed.as_secs_f64() * 1000.0, "phases": values,
+        }));
+    }
+}
