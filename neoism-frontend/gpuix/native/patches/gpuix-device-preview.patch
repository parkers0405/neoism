+    } else {
+        color+=direct_light(normal,view,normalize(vec3<f32>(-3.0,4.0,5.0)),srgb_to_linear(vec3<f32>(228.0,237.0,255.0)/255.0)*5.0,base,metal,roughness);
+        color+=direct_light(normal,view,normalize(vec3<f32>(3.0,1.0,-3.0)),vec3<f32>(4.0),base,metal,roughness);
+        color+=direct_light(normal,view,normalize(vec3<f32>(-2.0,-2.0,-4.0)),srgb_to_linear(vec3<f32>(159.0,172.0,212.0)/255.0)*2.0,base,metal,roughness);
