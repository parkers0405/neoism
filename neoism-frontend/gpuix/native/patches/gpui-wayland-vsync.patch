+impl Dispatch<wp_presentation_feedback::WpPresentationFeedback, ObjectId> for WaylandClientStatePtr {
+    fn event(_: &mut Self, _: &wp_presentation_feedback::WpPresentationFeedback, event: wp_presentation_feedback::Event, surface: &ObjectId, _: &Connection, _: &QueueHandle<Self>) {
+        match event {
+            wp_presentation_feedback::Event::Presented { tv_sec_hi, tv_sec_lo, tv_nsec, refresh, seq_hi, seq_lo, .. } => {
+                let seconds = (u64::from(tv_sec_hi) << 32) | u64::from(tv_sec_lo);
+                let sequence = (u64::from(seq_hi) << 32) | u64::from(seq_lo);
+                let time_ns = seconds * 1_000_000_000 + u64::from(tv_nsec);
+                crate::record_presentation(time_ns);
+                if std::env::var_os("GPUI_WAYLAND_PRESENTATION_TRACE").is_some() {
+                    eprintln!("[gpui-presented] surface={} time_ns={} refresh_ns={} sequence={}", surface.protocol_id(), time_ns, refresh, sequence);
+                }
+            }
+            wp_presentation_feedback::Event::Discarded => {
+                if std::env::var_os("GPUI_WAYLAND_PRESENTATION_TRACE").is_some() { eprintln!("[gpui-discarded] surface={}", surface.protocol_id()); }
+            },
+            _ => {}
+        }
+    }
+}
