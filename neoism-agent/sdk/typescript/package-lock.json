    },
    "packages/http": {
      "name": "@neoism/sdk-http",
      "version": "0.7.55",
      "dependencies": {
        "@neoism/sdk-core": "0.7.55"
      }
    },
    "packages/node": {
      "name": "@neoism/sdk-node",
      "version": "0.7.55",
      "dependencies": {
        "@neoism/sdk-core": "0.7.55",
        "@neoism/sdk-http": "0.7.55"
      }
    },
    "packages/plugin-subagents": {
      "name": "@neoism/sdk-plugin-subagents",
      "version": "0.7.55",
      "dependencies": {
        "@neoism/sdk-core": "0.7.55"
      }
    }
  }
