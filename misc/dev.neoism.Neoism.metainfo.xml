<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>dev.neoism.Neoism</id>
  <content_rating type="oars-1.1" />

  <name>Neoism</name>
  <summary>Hardware-accelerated terminal-first editor workspace</summary>

  <description>
    <p>Neoism is a hardware-accelerated terminal-first workspace for code, notes, agents, and multiplayer editing.</p>
    <p>It includes a GPU terminal, Rust-owned IDE chrome around managed Neovim, file tree, buffer tabs, command palette, diagnostics, finder, and agent terminal tabs.</p>
    <p>Key features:
      <ul>
        <li>Live CRDT collaborative editing</li>
        <li>Agent-driven code changes with LSP integration</li>
        <li>Markdown notes with vaults and graph views</li>
        <li>Native Rust LSP, diff panels, and Warp-style UI</li>
      </ul>
    </p>
  </description>

  <branding>
    <color type="primary" scheme_preference="light">#b9a5d3</color>
    <color type="primary" scheme_preference="dark">#2c1e3e</color>
  </branding>

  <project_license>MIT</project_license>
  <metadata_license>CC0-1.0</metadata_license>

  <launchable type="desktop-id">neoism.desktop</launchable>

  <developer id="dev.neoism">
    <name>Neoism contributors</name>
    <url>https://github.com/parkers0405/neoism</url>
  </developer>

  <!-- Added for open-sourcing prep: keywords, categories, and release tracking -->
  <keywords>
    <keyword>terminal</keyword>
    <keyword>editor</keyword>
    <keyword>ide</keyword>
    <keyword>rust</keyword>
    <keyword>neovim</keyword>
    <keyword>agent</keyword>
    <keyword>notes</keyword>
  </keywords>

  <categories>
    <category>Development</category>
    <category>Utility</category>
    <category>Office</category>
  </categories>

  <releases>
    <!-- Populated automatically by scripts/release.sh on each cut -->
    <release version="0.5.0" date="2025-08-01">
      <description>
        <p>Substantial improvements to dev/release scripts, added AppStream metadata enhancements, better cross-platform support prep, and open-source readiness updates (MIT LICENSE, no Claude attribution).</p>
      </description>
      <url>https://github.com/parkers0405/neoism/releases/tag/v0.5.0</url>
    </release>
  </releases>

  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </recommends>

  <provides>
    <binary>neoism</binary>
    <binary>neoism-workspace-daemon</binary>
    <binary>neoism-agent</binary>
  </provides>

</component>
