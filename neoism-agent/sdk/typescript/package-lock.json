{
  "name": "@neoism/sdk-workspace",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "@neoism/sdk-workspace",
      "workspaces": [
        "packages/*"
      ],
      "devDependencies": {
        "typescript": "^5.5.0"
      }
    },
    "node_modules/@neoism/sdk-all": {
      "resolved": "packages/all",
      "link": true
    },
    "node_modules/@neoism/sdk-core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@neoism/sdk-http": {
      "resolved": "packages/http",
      "link": true
    },
    "node_modules/@neoism/sdk-node": {
      "resolved": "packages/node",
      "link": true
    },
    "node_modules/@neoism/sdk-plugin-subagents": {
      "resolved": "packages/plugin-subagents",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
