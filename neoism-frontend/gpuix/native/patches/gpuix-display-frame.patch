@@ -0,0 +1,78 @@
+//! Data-only projection of the native editor's shaped insertion point. This
+//! module has no window/backend dependencies so its real geometry contract can
+//! also be verified with `rustc --test` on a headless builder.
+use std::ops::Range;
+
+/// CustomElementRegistry filters requested listeners using this exact list.
+/// Keep the geometry reporter opt-in reachable through the native registry.
+pub(crate) const INPUT_EVENTS:&[&str]=&[
+    "change","submit","click","keyDown","keyUp","focus","blur","fileDrop","caretGeometry",
+];
+
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) struct CaretGeometry {
+    pub x:f32,
+    pub y:f32,
+    pub height:f32,
+    pub font_size:f32,
+    pub remaining_width:f32,
+    pub visible:bool,
+    pub offset:usize,
+    pub selection_start:usize,
+    pub selection_end:usize,
+}
+impl CaretGeometry {
+    pub(crate) fn from_shaped(bounds:[f32;4],insertion:[f32;2],scroll:[f32;2],line_height:f32,font_size:f32,focused:bool,offset:usize,selection:Range<usize>)->Self {
+        let [left,top,width,height]=bounds;
+        let x=left+insertion[0]-scroll[0];
+        let y=top+insertion[1]-scroll[1];
+        Self{x,y,height:line_height,font_size,remaining_width:(left+width-x).max(0.0),
+            visible:focused&&selection.is_empty()&&x>=left&&x<left+width&&y<top+height&&y+line_height>top,
+            offset,selection_start:selection.start,selection_end:selection.end}
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn registry_keeps_the_opt_in_caret_geometry_listener(){
+        let requested=["change","caretGeometry","unsupported"];
+        let retained:Vec<_>=requested.into_iter().filter(|event|INPUT_EVENTS.contains(event)).collect();
+        assert_eq!(retained,vec!["change","caretGeometry"]);
+    }
+    fn project(point:[f32;2],scroll:[f32;2],focused:bool,selection:Range<usize>)->CaretGeometry {
+        CaretGeometry::from_shaped([120.0,240.0,300.0,44.0],point,scroll,22.0,16.0,focused,selection.end,selection)
+    }
+    #[test]
+    fn wrapped_and_scrolled_native_insertion_is_reported_in_window_coordinates(){
+        let geometry=project([71.25,44.0],[12.5,22.0],true,8..8);
+        assert_eq!((geometry.x,geometry.y),(178.75,262.0));
+        assert_eq!(geometry.remaining_width,241.25);
+        assert_eq!((geometry.height,geometry.font_size),(22.0,16.0));assert!(geometry.visible);
+        assert_eq!(geometry,project([71.25,44.0],[12.5,22.0],true,8..8));
+    }
+    #[test]
+    fn unicode_byte_offsets_are_not_recomputed_as_characters_or_utf16(){
+        let offset="界🙂e\u{301}".len();let geometry=project([51.75,0.0],[0.0,0.0],true,offset..offset);
+        assert_eq!(geometry.offset,offset);assert_eq!(geometry.selection_start,offset);assert_eq!(geometry.selection_end,offset);
+        assert_eq!(geometry.x,171.75);
+    }
+    #[test]
+    fn selection_focus_and_viewport_edges_control_visibility(){
+        assert!(!project([10.0,0.0],[0.0,0.0],false,1..1).visible);
+        assert!(!project([10.0,0.0],[0.0,0.0],true,1..5).visible);
+        assert!(!project([301.0,0.0],[0.0,0.0],true,1..1).visible);
+        assert!(!project([10.0,44.0],[0.0,0.0],true,1..1).visible);
+        assert!(!project([10.0,0.0],[11.0,0.0],true,1..1).visible);
+        assert!(!project([10.0,0.0],[0.0,22.0],true,1..1).visible);
+        assert!(project([10.0,0.0],[0.0,21.5],true,1..1).visible);
+        assert_eq!(project([301.0,0.0],[0.0,0.0],true,1..1).remaining_width,0.0);
+    }
+    #[test]
+    fn same_point_different_selection_or_offset_still_emits_a_state_change(){
+        let first=project([10.0,0.0],[0.0,0.0],true,1..1);
+        assert_ne!(first,project([10.0,0.0],[0.0,0.0],true,2..2));
+        assert_ne!(first,project([10.0,0.0],[0.0,0.0],true,1..2));
+    }
+}
