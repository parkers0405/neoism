+#[cfg(test)]
+mod image_group_tests {
+    use super::*;
+
+    fn image(bounds: [f32; 4]) -> Op {
+        Op::Image { key: 1, bounds, radii: [0.0; 4], source: [0.0, 0.0, 1.0, 1.0] }
+    }
+
+    #[test]
+    fn disjoint_images_share_their_union_and_touching_edges_are_safe() {
+        let ops = [image([0.0, 0.0, 10.0, 10.0]), image([10.0, 0.0, 5.0, 10.0]), image([0.0, 10.0, 15.0, 5.0])];
+        assert_eq!(image_group(&ops, 0), Some((3, [0.0, 0.0, 15.0, 15.0])));
+    }
+
+    #[test]
+    fn overlap_with_any_prior_image_splits_the_layer() {
+        let ops = [image([0.0, 0.0, 10.0, 10.0]), image([20.0, 0.0, 10.0, 10.0]), image([5.0, 0.0, 5.0, 10.0])];
+        assert_eq!(image_group(&ops, 0), Some((2, [0.0, 0.0, 30.0, 10.0])));
+        assert_eq!(image_group(&[image([0.0, 0.0, 10.0, 10.0]), image([5.0, 5.0, 10.0, 10.0])], 0), None);
+    }
+
+    #[test]
+    fn clips_and_non_image_ink_are_never_crossed() {
+        for boundary in [Op::Clip([0.0, 0.0, 100.0, 100.0]), Op::Unclip,
+            Op::Rect { bounds: [0.0, 0.0, 100.0, 100.0], color: gpui::transparent_black(), radii: [0.0; 4], border: None }]
+        {
+            let ops = [image([0.0, 0.0, 10.0, 10.0]), image([20.0, 0.0, 10.0, 10.0]), boundary, image([40.0, 0.0, 10.0, 10.0])];
+            assert_eq!(image_group(&ops, 0).unwrap().0, 2);
+            assert_eq!(image_group(&ops, 2), None);
+        }
+    }
+
+    #[test]
+    fn groups_are_bounded_and_invalid_geometry_falls_back() {
+        let ops: Vec<_> = (0..40).map(|i| image([i as f32 * 20.0, 0.0, 10.0, 10.0])).collect();
+        assert_eq!(image_group(&ops, 0).unwrap().0, 32);
+        assert_eq!(image_group(&ops, 32).unwrap().0, 40);
+        assert_eq!(image_group(&[image([0.0, 0.0, 0.0, 10.0]), image([20.0, 0.0, 10.0, 10.0])], 0), None);
+        assert_eq!(image_group(&[image([f32::INFINITY, 0.0, 10.0, 10.0]), image([20.0, 0.0, 10.0, 10.0])], 0), None);
+    }
+}
