+impl Dispatch<wp_presentation::WpPresentation, ()> for WaylandClientStatePtr {
+    fn event(_: &mut Self, _: &wp_presentation::WpPresentation, _: wp_presentation::Event, _: &(), _: &Connection, _: &QueueHandle<Self>) {}
