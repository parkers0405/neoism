+    let palette=array<vec3<f32>,5>(vec3<f32>(0.53,0.60,0.60),vec3<f32>(0.43,0.52,0.55),vec3<f32>(0.31,0.43,0.48),vec3<f32>(0.21,0.35,0.42),vec3<f32>(0.12,0.26,0.34));
+    for(var index=0u;index<5u;index++) {let edge=curve+f32(index)*0.072;color=mix(color,palette[index],smoothstep(edge-0.004,edge+0.004,v));}
+    return color;
+}
+@fragment fn fragment(input:Varying) -> @location(0) vec4<f32> {
+    let flat=settings.pose.y>=2.0;let has_frame=settings.pose.y==1.0||settings.pose.y==3.0;let material=i32(input.material+0.5);
+    let footprint=max(length(dpdx(input.position)),length(dpdy(input.position)));
+    if material==2 {
+        if flat&&!has_frame {return vec4<f32>(0.0);}
+        if !has_frame&&settings.projection.z>0.5 {var uv=input.uv;if settings.projection.w>0.5&&input.display==0.0 {uv=vec2<f32>(1.0-uv.y,uv.x);}return vec4<f32>(preview_wallpaper(uv),1.0);}
+        if has_frame&&(flat||input.display==settings.pose.z) {
+            var source_uv=input.uv;var source_aspect=input.aspect;
+            let dimensions=textureDimensions(screen);
+            if !flat&&settings.projection.w>0.5&&input.display==0.0&&dimensions.x>dimensions.y {source_uv=vec2<f32>(1.0-source_uv.y,source_uv.x);source_aspect=1.0/source_aspect;}
+            let uv=content_uv(source_uv,select(source_aspect,settings.viewport.x/settings.viewport.y,flat));
+            if any(uv<vec2<f32>(0.0))||any(uv>vec2<f32>(1.0)) {return vec4<f32>(0.0,0.0,0.0,select(1.0,0.0,flat));}
+            // Same unlit sRGB path as MeshBasicMaterial: video is not lit, gamma-adjusted, reflected over, or tone mapped.
+            return vec4<f32>(textureSampleLevel(screen,screen_sampler,uv,0.0).rgb,1.0);
+        }
+        return vec4<f32>(mix(vec3<f32>(0.012,0.018,0.03),vec3<f32>(0.035,0.055,0.085),input.uv.y),1.0);
+    }
+    let normal=normalize(input.normal);let view=normalize(vec3<f32>(settings.pose.w,settings.finish.w,settings.pose.x)-input.position);
+    let no_v=max(dot(normal,view),0.0001);let reflected=reflect(-view,normal);
+    var base=srgb_to_linear(settings.finish.rgb);var metal=0.87;var roughness=0.46;var coat=0.08;
+    if material==1 {base*=0.36;metal=0.48;roughness=0.68;coat=0.08;}
+    if material==1&&settings.projection.y==1.0 {base=srgb_to_linear(settings.finish.rgb);metal=0.0;roughness=0.7;coat=0.1;}
+    if material==3 {base=vec3<f32>(0.0015,0.002,0.003);metal=0.0;roughness=0.38;coat=0.18;}
+    if material==4 {
+        let radial=length(input.uv-vec2<f32>(0.5))*2.0;
