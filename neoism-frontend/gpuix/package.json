    "prebenchmark:fps": "npm run build:sdk"
  },
  "dependencies": {
    "@gpuix/native": "0.11.0",
    "@gpuix/solid": "0.11.0",
    "effect": "4.0.6",
    "jsonc-parser": "3.3.1",
    "solid-js": "1.9.17",
    "ws": "8.22.0",
    "@neoism/sdk-core": "file:../../neoism-agent/sdk/typescript/packages/core",
    "@neoism/sdk-http": "file:../../neoism-agent/sdk/typescript/packages/http",
    "@neoism/sdk-plugin-builtins": "file:../../neoism-agent/sdk/typescript/packages/plugin-builtins",
    "@neoism/sdk-plugin-subagents": "file:../../neoism-agent/sdk/typescript/packages/plugin-subagents",
    "@neoism/sdk": "file:../../neoism-agent/sdk/typescript/packages/sdk"
  },
  "devDependencies": {
    "@types/bun": "1.3.12",
    "@types/ws": "8.18.1",
    "bun": "1.3.13",
    "typescript": "5.9.3"
