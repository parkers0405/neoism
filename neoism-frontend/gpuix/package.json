    "check:finder": "bun scripts/native-finder-check.ts",
    "precheck:finder": "npm run build:sdk",
    "check:terminal": "bun scripts/native-terminal-check.ts",
    "precheck:terminal": "npm run build:sdk",
    "setup:blaze": "bun scripts/bootstrap-blaze.ts",
    "check:commands": "bun scripts/native-command-check.ts",
    "check:app-commands": "bun scripts/native-app-command-check.ts",
    "precheck:app-commands": "npm run build:sdk",
    "precheck:commands": "npm run build:sdk",
    "check:provider": "bun scripts/native-provider-check.ts",
    "check:chrome": "bun scripts/native-chrome-check.ts",
    "check:menus": "bun scripts/native-menu-check.ts",
