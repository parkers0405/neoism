+use std::{collections::HashMap, sync::{Arc, atomic::{AtomicU32, Ordering}, LazyLock}};
+use parking_lot::Mutex;
+use napi_derive::napi;
+use crate::renderer::GpuixRenderer;
+
+#[path = "device_viewport_mesh.rs"]
+mod mesh;
+
+#[derive(Clone, Copy, PartialEq, Debug, serde::Deserialize, serde::Serialize)]
+enum Model {
+    #[serde(rename="iphone-18-pro")] Pro,
+    #[serde(rename="iphone-18-pro-max")] Max,
+    #[serde(rename="iphone-duo")] Duo,
+    #[serde(rename="ipad-pro-13-m5")] Tablet,
+}
+#[derive(Clone, Copy, PartialEq, Debug, serde::Deserialize, serde::Serialize)]
+#[serde(rename_all="lowercase")]
+enum Display { Inner, Cover }
+#[derive(Clone, Copy, PartialEq, Debug, serde::Deserialize, serde::Serialize)]
+#[serde(rename_all="snake_case")]
+enum Orientation { Portrait, PortraitUpsideDown, LandscapeLeft, LandscapeRight }
+impl Display {
+    fn number(self) -> f32 { if self==Self::Inner {0.0} else {1.0} }
+    fn name(self) -> &'static str { if self==Self::Inner {"inner"} else {"cover"} }
+}
+#[derive(Clone, Copy, PartialEq, serde::Deserialize, serde::Serialize)]
+#[serde(default, deny_unknown_fields)]
+struct Options { model: Model, color: [f32;3], keyboard: bool, display: Display, orientation:Orientation, yaw: f32, pitch: f32, hinge: f32, zoom: f32, flat: bool, preview: bool, #[serde(rename="duoBook")] duo_book: bool }
+impl Default for Options {
+    fn default() -> Self { Self { model:Model::Pro,color:[0.262,0.145,0.157],keyboard:false,display:Display::Inner,orientation:Orientation::Portrait,yaw:0.0,pitch:0.0,hinge:0.0,zoom:1.0,flat:false,preview:false,duo_book:false } }
+}
+#[derive(Clone)]
+struct Frame { width: u32, height: u32, bytes: Arc<[u8]> }
+#[derive(Clone)]
+struct Viewport { options: Options, frame: Option<Frame>, pose_revision: u64, frame_revision: u64, mesh: Arc<mesh::Mesh> }
+impl Default for Viewport {
+    fn default() -> Self {let options=Options::default(); Self {options,frame:None,pose_revision:0,frame_revision:0,mesh:Arc::new(mesh::Mesh::build(options))}}
+}
+impl Default for mesh::Mesh { fn default() -> Self { Self {vertices:Vec::new(),indices:Vec::new()} } }
+static VIEWPORTS: LazyLock<Mutex<HashMap<u32, Viewport>>> = LazyLock::new(|| Mutex::new(HashMap::new()));
+static NEXT_ID: AtomicU32 = AtomicU32::new(1);
+fn invalid(message: &str) -> napi::Error { napi::Error::from_reason(message) }
+fn options_update(previous: Options, json: &str) -> napi::Result<Options> {
+    let mut merged = serde_json::to_value(previous).map_err(|error| invalid(&error.to_string()))?;
+    let update: serde_json::Map<String, serde_json::Value> = serde_json::from_str(json).map_err(|error| invalid(&error.to_string()))?;
+    if let Some(object) = merged.as_object_mut() { object.extend(update); }
+    let mut options: Options = serde_json::from_value(merged).map_err(|error| invalid(&error.to_string()))?;
+    if ![options.yaw, options.pitch, options.hinge, options.zoom].iter().all(|number| number.is_finite()) { return Err(invalid("Device pose must be finite")); }
+    if !options.color.iter().all(|number| number.is_finite() && (0.0..=1.0).contains(number)) {return Err(invalid("Device color must be three normalized sRGB numbers"));}
+    options.yaw = options.yaw.rem_euclid(std::f32::consts::TAU);
+    let pitch_limit=if options.model==Model::Duo {std::f32::consts::FRAC_PI_2} else {1.3};
+    options.pitch = options.pitch.clamp(-pitch_limit, pitch_limit);
+    options.hinge = options.hinge.clamp(0.0, std::f32::consts::PI);
+    options.zoom = options.zoom.clamp(0.5, 2.0);
+    if options.model != Model::Duo {options.hinge=0.0; options.display=Display::Inner;}
+    if options.model != Model::Tablet {options.keyboard=false;}
+    Ok(options)
+}
+
+#[napi]
+pub fn device_preview_supported() -> bool { cfg!(any(target_os = "linux", target_os = "freebsd")) }
+
+#[napi]
+impl GpuixRenderer {
+    #[napi]
+    pub fn create_device_viewport(&self, options_json: Option<String>) -> napi::Result<u32> {
+        if !device_preview_supported() { return Err(invalid("Device preview requires a GPUI wgpu window")); }
+        let options = options_update(Options::default(), options_json.as_deref().unwrap_or("{}"))?;
+        let mut viewports = VIEWPORTS.lock();
+        if viewports.len() >= 16 { return Err(invalid("At most 16 device viewports may be live")); }
+        let id = NEXT_ID.fetch_update(Ordering::Relaxed, Ordering::Relaxed, |id| id.checked_add(1)).map_err(|_| invalid("Device viewport IDs exhausted"))?;
+        viewports.insert(id, Viewport { options, mesh:Arc::new(mesh::Mesh::build(options)), ..Default::default() });
+        Ok(id)
+    }
+    #[napi]
+    pub fn update_device_viewport(&self, id: u32, options_json: String) -> napi::Result<()> {
+        let mut viewports = VIEWPORTS.lock();
+        let viewport = viewports.get_mut(&id).ok_or_else(|| invalid("Unknown device viewport"))?;
+        let options = options_update(viewport.options, &options_json)?;
+        if options != viewport.options {
+            if mesh_key(options)!=mesh_key(viewport.options) {viewport.mesh=Arc::new(mesh::Mesh::build(options));}
+            viewport.options = options; viewport.pose_revision = viewport.pose_revision.wrapping_add(1);
+        }
+        Ok(())
+    }
+    #[napi]
+    pub fn put_device_frame(&self, id: u32, width: u32, height: u32, rgba: napi::bindgen_prelude::Buffer) -> napi::Result<()> {
+        validate_frame(width, height, rgba.len())?;
+        let mut viewports = VIEWPORTS.lock();
+        let viewport = viewports.get_mut(&id).ok_or_else(|| invalid("Unknown device viewport"))?;
+        viewport.frame = Some(Frame { width, height, bytes: Arc::from(rgba.as_ref()) });
+        viewport.frame_revision = viewport.frame_revision.wrapping_add(1);
+        Ok(())
+    }
+    #[napi]
+    pub fn drop_device_viewport(&self, id: u32) -> napi::Result<()> {
+        VIEWPORTS.lock().remove(&id).ok_or_else(|| invalid("Unknown device viewport"))?;
+        Ok(())
+    }
+    #[napi]
+    pub fn clear_device_frame(&self, id: u32) -> napi::Result<()> {
+        let mut viewports = VIEWPORTS.lock();
+        let viewport = viewports.get_mut(&id).ok_or_else(|| invalid("Unknown device viewport"))?;
+        viewport.frame = None;
+        viewport.frame_revision = viewport.frame_revision.wrapping_add(1);
+        Ok(())
+    }
+    #[napi]
+    pub fn hit_device_viewport(&self, id:u32, x:f64, y:f64, width:f64, height:f64) -> napi::Result<String> {
+        if ![x,y,width,height].iter().all(|value| value.is_finite()) || width<=0.0 || height<=0.0 || x<0.0 || y<0.0 || x>width || y>height {return Ok("null".into());}
+        let viewport=VIEWPORTS.lock().get(&id).cloned().ok_or_else(|| invalid("Unknown device viewport"))?;
+        let Some(frame)=viewport.frame else {return Ok("null".into());};
+        let hit=viewport.mesh.hit(viewport.options,[x as f32,y as f32],[width as f32,height as f32],[frame.width as f32,frame.height as f32]);
+        Ok(hit.map_or_else(||"null".into(),|uv|serde_json::json!({"x":uv[0],"y":uv[1],"display":viewport.options.display.name()}).to_string()))
+    }
+    #[napi]
+    pub fn facing_device_viewport(&self,id:u32) -> napi::Result<String> {
+        let viewport=VIEWPORTS.lock().get(&id).cloned().ok_or_else(|| invalid("Unknown device viewport"))?;
+        Ok(viewport.mesh.facing(viewport.options).name().into())
+    }
+}
+fn mesh_key(options:Options) -> (Model,bool,u32,bool,Orientation,bool) {(options.model,options.keyboard,options.hinge.to_bits(),options.flat,if options.model==Model::Duo||options.keyboard {Orientation::Portrait} else {options.orientation},options.model==Model::Duo&&options.duo_book)}
+fn validate_frame(width: u32, height: u32, length: usize) -> napi::Result<()> {
+    if width == 0 || height == 0 || width > 4096 || height > 4096 || length != width as usize * height as usize * 4 { return Err(invalid("Expected tightly packed RGBA8, dimensions 1..4096, at most 64 MiB")); }
+    Ok(())
+}
+
+#[cfg(any(target_os = "linux", target_os = "freebsd"))]
+mod surface {
+    use super::*;
+    use super::super::{CustomElement, CustomElementFactory, CustomRenderContext, custom_surface};
+    use gpui::{prelude::*, canvas, div, size, DevicePixels};
+    use std::cell::RefCell;
+    use wgpu::util::DeviceExt;
+
+    pub struct DeviceViewportFactory;
+    impl CustomElementFactory for DeviceViewportFactory {
+        fn element_type(&self) -> &str { "device_viewport" }
+        fn create(&self, _id: u64) -> Box<dyn CustomElement> { Box::new(DeviceElement { viewport_id: 0, gpu: Default::default() }) }
+    }
+    struct DeviceElement { viewport_id: u32, gpu: std::rc::Rc<RefCell<Option<GpuSurface>>> }
+    impl CustomElement for DeviceElement {
+        fn set_prop(&mut self, key: &str, value: serde_json::Value) {
+            if key == "viewportId" { self.viewport_id = value.as_u64().and_then(|number| u32::try_from(number).ok()).unwrap_or(0); self.gpu.borrow_mut().take(); }
+        }
+        fn supported_props(&self) -> &'static [&'static str] { &["viewportId", "frameRevision"] }
+        fn supported_events(&self) -> &'static [&'static str] { &["click", "mouseEnter", "mouseLeave"] }
+        fn destroy(&mut self) { self.gpu.borrow_mut().take(); }
+        fn render(&mut self, context: CustomRenderContext, _window: &mut gpui::Window, _cx: &mut gpui::Context<crate::renderer::GpuixView>) -> gpui::AnyElement {
+            let id = self.viewport_id;
+            let gpu = self.gpu.clone();
+            custom_surface(div().id(format!("__gpuix_device_{}", context.id)), &context)
+                .child(canvas(|_, _, _| (), move |bounds, (), window, _| {
+                    let mut resource = gpu.borrow_mut();
+                    if window.gpu_device_lost() == Some(true) { resource.take(); return; }
+                    let Some(context) = window.gpu_context().and_then(|context| context.downcast::<(Arc<wgpu::Device>, Arc<wgpu::Queue>)>().ok()) else { resource.take(); return; };
+                    let (device, queue) = *context;
+                    let width = (f32::from(bounds.size.width) * window.scale_factor()).ceil();
+                    let height = (f32::from(bounds.size.height) * window.scale_factor()).ceil();
+                    if width <= 0.0 || height <= 0.0 || !width.is_finite() || !height.is_finite() { return; }
