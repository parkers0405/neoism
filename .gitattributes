# Preserve published dependency source bytes, including upstream whitespace.
vendor/blaze-compat/** linguist-vendored -whitespace

# Pinned Rune dependency includes required upstream GPU libraries and test assets.
# Keep them versioned, but do not present compiled shader/data blobs as source diffs.
rune/vendor/** linguist-vendored
rune/vendor/**/*.metallib binary
rune/vendor/**/*.dxbc binary
rune/vendor/**/*.bin binary

# Display patches are verified byte-for-byte on every build host.
neoism-frontend/gpuix/native/patches/*.patch text eol=lf
