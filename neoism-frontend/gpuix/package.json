{
  "name": "@neoism/gpuix",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-solid-host.cjs",
    "dev": "bun --hot src/main.tsx",
    "start": "bun src/main.tsx",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./tests",
    "sync:design": "bun scripts/sync-design.ts",
    "check:design": "bun scripts/sync-design.ts --check",
    "build": "bun scripts/build.ts",
    "smoke:daemon": "bun scripts/smoke-daemon.ts",
    "check:native": "bun scripts/native-check.ts",
    "build:core": "bun scripts/build-core.ts",
    "build:display": "bun scripts/build-display-binding.ts",
    "check:display": "bun scripts/check-display-binding.ts",
    "setup:runtime": "node node_modules/bun/install.js",
    "check:agent": "bun scripts/native-agent-check.ts",
    "build:sdk": "bun scripts/build-sdk.ts",
    "predev": "npm run build:sdk",
    "prestart": "npm run build:sdk",
    "pretest": "npm run build:sdk",
    "pretypecheck": "npm run build:sdk",
    "prebuild": "npm run build:sdk",
    "precheck:agent": "npm run build:sdk",
    "precheck:native": "npm run build:sdk",
    "presmoke:daemon": "npm run build:sdk",
    "build:ghostty": "bun scripts/build-ghostty.ts",
    "check:layout": "bun scripts/native-layout-check.ts",
    "check:timeline": "bun scripts/native-timeline-check.ts",
