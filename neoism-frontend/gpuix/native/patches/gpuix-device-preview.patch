+    }
+    if material==5 {base=mix(base,vec3<f32>(0.55),0.10);metal=1.0;roughness=0.2;coat=0.0;}
+    if material==6 {return vec4<f32>(0.94,0.9,0.78,1.0);}
+    if material==7 {base=vec3<f32>(0.009,0.011,0.015);metal=0.0;roughness=0.85;coat=0.0;}
+    if material==8 {base=vec3<f32>(0.0001,0.0003,0.0006);metal=0.0;roughness=0.075;coat=0.9;}
+    if material==9 {base=vec3<f32>(0.055,0.06,0.07);metal=0.0;roughness=0.82;coat=0.0;}
+    if material==11 {base*=0.75;metal=0.72;roughness=0.52;coat=0.08;}
+    if material==12 {base=vec3<f32>(0.48,0.5,0.53);metal=0.0;roughness=0.8;coat=0.0;}
+    if material==13 {base=vec3<f32>(0.018,0.020,0.024);metal=0.12;roughness=0.76;coat=0.0;}
+    // Stable, derivative-filtered microfinish: no temporal noise, textures, or sparkle under minification.
+    let grain=sin(dot(input.local_position,vec3<f32>(1731.0,1297.0,997.0)))*sin(dot(input.local_position,vec3<f32>(877.0,1543.0,1103.0)));
+    if material==1&&settings.projection.y==0.0 {base*=0.55+0.55*smoothstep(-1.5,0.6,input.local_position.y);}
+    if material==0||material==1||material==11 {roughness=clamp(roughness+grain*0.018*(1.0-smoothstep(0.0005,0.003,footprint)),0.04,1.0);}
