--- /dev/null
+++ w/packages/native/src/custom_elements/canvas.rs
@@ -0,0 +1,596 @@
+//! `<canvas>`: one GPUI element that paints a retained display list.
+//!
+//! Every `<div>`, `<text>` and `<img>` host costs a stateful GPUI element, a
+//! taffy node, a prepaint and a paint pass on every frame. Dense surfaces such
+//! as a code viewport or painter output have hundreds of primitives that never
+//! need layout or events of their own, so they paint here instead: quads,
+//! shaped text, paths and images straight into the scene from one canvas.
+//!
+//! `commands` is a JSON string, compared by equality and parsed only when it
+//! changes. Coordinates are relative to the element's box. Images reference
+//! the process-wide [`PaintImageStore`] by key; uploads never wait for the UI
+//! thread, and a key's pixels must not change once published.
+
+use std::collections::HashMap;
+use std::rc::Rc;
+use std::sync::{Arc, LazyLock, Mutex};
+use std::sync::atomic::{AtomicU64, Ordering};
+
+use serde::Deserialize;
+
+use super::{CustomElement, CustomElementFactory, CustomRenderContext};
+
+// ── Image store ──────────────────────────────────────────────────────
+
+#[derive(Default)]
+pub struct PaintImageStore {
+    images: HashMap<u64, Arc<gpui::RenderImage>>,
+    /// Replaced or released images whose atlas tiles must be freed on the UI
+    /// thread, which owns the window.
+    drops: Vec<Arc<gpui::RenderImage>>,
+}
+
+static PAINT_IMAGES: LazyLock<Mutex<PaintImageStore>> = LazyLock::new(Default::default);
+static IMAGE_GENERATION: AtomicU64 = AtomicU64::new(0);
+
+pub fn put_paint_image(key: u64, image: Arc<gpui::RenderImage>) {
+    let mut store = PAINT_IMAGES.lock().unwrap();
+    if let Some(previous) = store.images.insert(key, image) {
+        store.drops.push(previous);
+    }
+    IMAGE_GENERATION.fetch_add(1, Ordering::Release);
+}
+
+pub fn drop_paint_image(key: u64) {
+    let mut store = PAINT_IMAGES.lock().unwrap();
+    if let Some(previous) = store.images.remove(&key) {
+        store.drops.push(previous);
+        IMAGE_GENERATION.fetch_add(1, Ordering::Release);
+    }
+}
+
+pub fn clear_paint_images() {
+    let mut store = PAINT_IMAGES.lock().unwrap();
+    let images: Vec<_> = store.images.drain().map(|(_, image)| image).collect();
+    store.drops.extend(images);
+    IMAGE_GENERATION.fetch_add(1, Ordering::Release);
+}
+
+/// Free atlas tiles of released images. Call from the UI thread each frame.
+pub fn release_dropped_paint_images(window: &mut gpui::Window) {
+    let drops = std::mem::take(&mut PAINT_IMAGES.lock().unwrap().drops);
+    for image in drops {
+        window.drop_image(image).ok();
+    }
+}
+
+// ── Display list ─────────────────────────────────────────────────────
+
+#[derive(Deserialize)]
+#[serde(tag = "k")]
+enum RawOp {
+    /// Rounded rect: `b` = [x, y, w, h], `r` = [tl, tr, br, bl], optional border.
+    #[serde(rename = "r")]
+    Rect {
+        b: [f32; 4],
+        c: u32,
+        #[serde(default)]
+        r: Option<[f32; 4]>,
+        #[serde(default)]
+        bc: Option<u32>,
+        #[serde(default)]
+        bw: Option<f32>,
+    },
+    /// Image from the store, stretched to `b`. `s` = normalized
+    /// `[u0, v0, u1, v1]` source slice (default: whole image).
+    #[serde(rename = "i")]
+    Image {
+        id: u64,
+        b: [f32; 4],
+        #[serde(default)]
+        r: Option<[f32; 4]>,
+        #[serde(default)]
+        s: Option<[f32; 4]>,
+    },
+    /// One shaped line. `y` is the top of a `lh` tall line box. With `aw`, the
+    /// line is aligned inside `[x, x + aw]` by `al` ("l", "c", "r").
+    #[serde(rename = "t")]
+    Text {
+        x: f32,
+        y: f32,
+        t: String,
+        s: f32,
+        c: u32,
+        f: String,
+        #[serde(default)]
+        w: Option<f32>,
+        #[serde(default)]
+        i: Option<bool>,
+        #[serde(default)]
+        lh: Option<f32>,
+        #[serde(default)]
+        aw: Option<f32>,
+        #[serde(default)]
+        al: Option<String>,
+    },
+    /// Filled contours (even-odd), each a flat [x0, y0, x1, y1, ...] list.
+    #[serde(rename = "p")]
+    Fill { c: u32, p: Vec<Vec<f32>> },
+    /// Open polyline stroke.
+    #[serde(rename = "l")]
+    Stroke { c: u32, w: f32, p: Vec<f32> },
+    /// Push a clip rect; pairs with `u`.
+    #[serde(rename = "cl")]
+    Clip { b: [f32; 4] },
+    #[serde(rename = "u")]
+    Unclip,
+}
+
+enum Op {
+    Rect {
+        bounds: [f32; 4],
+        color: gpui::Hsla,
+        radii: [f32; 4],
+        border: Option<(gpui::Hsla, f32)>,
+    },
+    Image {
+        key: u64,
+        bounds: [f32; 4],
+        radii: [f32; 4],
+        source: [f32; 4],
+    },
+    Text {
+        x: f32,
+        y: f32,
+        text: gpui::SharedString,
+        size: f32,
+        color: gpui::Hsla,
+        font: gpui::Font,
+        line_height: f32,
+        align: Option<(f32, gpui::TextAlign)>,
+    },
+    Fill {
+        color: gpui::Hsla,
+        contours: Vec<Vec<f32>>,
+    },
+    Stroke {
+        color: gpui::Hsla,
+        width: f32,
+        points: Vec<f32>,
+    },
+    Clip([f32; 4]),
+    Unclip,
+}
+
+fn color(rgba: u32) -> gpui::Hsla {
+    gpui::rgba(rgba).into()
+}
+
+impl From<RawOp> for Op {
+    fn from(raw: RawOp) -> Self {
+        match raw {
+            RawOp::Rect { b, c, r, bc, bw } => Op::Rect {
+                bounds: b,
+                color: color(c),
+                radii: r.unwrap_or_default(),
+                border: bc.zip(bw).filter(|(_, width)| *width > 0.0).map(|(c, w)| (color(c), w)),
+            },
+            RawOp::Image { id, b, r, s } => Op::Image {
+                key: id,
+                bounds: b,
+                radii: r.unwrap_or_default(),
+                source: s.unwrap_or([0.0, 0.0, 1.0, 1.0]),
+            },
+            RawOp::Text { x, y, t, s, c, f, w, i, lh, aw, al } => {
+                let mut font = gpui::font(f);
+                font.weight = gpui::FontWeight(w.unwrap_or(400.0));
+                if i.unwrap_or(false) {
+                    font.style = gpui::FontStyle::Italic;
+                }
+                let align = aw.map(|width| {
+                    let align = match al.as_deref() {
+                        Some("r") => gpui::TextAlign::Right,
+                        Some("c") => gpui::TextAlign::Center,
+                        _ => gpui::TextAlign::Left,
+                    };
+                    (width, align)
+                });
+                Op::Text {
+                    x,
+                    y,
+                    text: t.into(),
+                    size: s,
+                    color: color(c),
+                    font,
+                    line_height: lh.unwrap_or(s),
+                    align,
+                }
+            }
+            RawOp::Fill { c, p } => Op::Fill {
+                color: color(c),
+                contours: p,
+            },
+            RawOp::Stroke { c, w, p } => Op::Stroke {
+                color: color(c),
+                width: w,
+                points: p,
+            },
+            RawOp::Clip { b } => Op::Clip(b),
+            RawOp::Unclip => Op::Unclip,
+        }
+    }
+}
+
+fn parse(source: &str) -> Vec<Op> {
+    if source.is_empty() {
+        return Vec::new();
+    }
+    let started = std::env::var_os("GPUI_CANVAS_PARSE_TRACE").is_some().then(std::time::Instant::now);
+    let parsed = serde_json::from_str::<Vec<RawOp>>(source);
+    if let Some(started) = started { eprintln!("[gpui-canvas-parse] bytes={} time_us={}", source.len(), started.elapsed().as_micros()); }
+    match parsed {
+        Ok(ops) => ops.into_iter().map(Op::from).collect(),
+        Err(error) => {
+            log::warn!("<canvas> commands are invalid: {error}");
+            Vec::new()
+        }
+    }
+}
+
+fn rect(origin: gpui::Point<gpui::Pixels>, b: &[f32; 4]) -> gpui::Bounds<gpui::Pixels> {
+    gpui::Bounds::new(
+        gpui::point(origin.x + gpui::px(b[0]), origin.y + gpui::px(b[1])),
+        gpui::size(gpui::px(b[2].max(0.0)), gpui::px(b[3].max(0.0))),
+    )
+}
+
+fn corners(r: &[f32; 4]) -> gpui::Corners<gpui::Pixels> {
+    gpui::Corners {
+        top_left: gpui::px(r[0]),
+        top_right: gpui::px(r[1]),
+        bottom_right: gpui::px(r[2]),
+        bottom_left: gpui::px(r[3]),
+    }
+}
+
+fn paint_ops(ops: &[Op], origin: gpui::Point<gpui::Pixels>, window: &mut gpui::Window, cx: &mut gpui::App) {
+    let images: HashMap<u64, Arc<gpui::RenderImage>> = {
+        let store = PAINT_IMAGES.lock().unwrap();
+        ops.iter()
+            .filter_map(|op| match op {
+                Op::Image { key, .. } => store.images.get(key).map(|image| (*key, image.clone())),
+                _ => None,
+            })
+            .collect()
+    };
+    let mut index = 0;
+    paint_range(ops, &mut index, origin, &images, window, cx);
+}
+
+/// GPUI may sort sprites with the same layer order by atlas tile. Only
+/// pairwise-disjoint, consecutive images may therefore share a layer.
+/// Keep this scan bounded even for very large text display lists.
+fn image_group(ops: &[Op], start: usize) -> Option<(usize, [f32; 4])> {
+    const MAX_IMAGES: usize = 32;
+    let mut boxes = [[0.0f32; 4]; MAX_IMAGES];
+    let mut count = 0;
+    let mut union = [0.0f32; 4]; // left, top, right, bottom
+    for op in ops.iter().skip(start).take(MAX_IMAGES) {
+        let Op::Image { bounds, .. } = op else { break };
+        let [x, y, width, height] = *bounds;
+        let edges = [x, y, x + width, y + height];
+        if width <= 0.0 || height <= 0.0 || !edges.iter().all(|edge| edge.is_finite()) {
+            break;
+        }
+        if boxes[..count].iter().any(|previous| {
+            edges[0] < previous[2] && previous[0] < edges[2]
+                && edges[1] < previous[3] && previous[1] < edges[3]
+        }) {
+            break;
+        }
+        union = if count == 0 { edges } else {
+            [union[0].min(edges[0]), union[1].min(edges[1]),
+             union[2].max(edges[2]), union[3].max(edges[3])]
+        };
+        boxes[count] = edges;
+        count += 1;
+    }
+    let bounds = [union[0], union[1], union[2] - union[0], union[3] - union[1]];
+    (count > 1 && bounds.iter().all(|value| value.is_finite())).then_some((start + count, bounds))
+}
+
+fn paint_image_op(
+    op: &Op,
+    origin: gpui::Point<gpui::Pixels>,
+    images: &HashMap<u64, Arc<gpui::RenderImage>>,
+    window: &mut gpui::Window,
+) {
+    let Op::Image { key, bounds, radii, source } = op else { return };
+    if let Some(image) = images.get(key) {
+        let visible = rect(origin, bounds);
+        let [u0, v0, u1, v1] = *source;
+        let (du, dv) = ((u1 - u0).max(1e-6), (v1 - v0).max(1e-6));
+        // GPUI crops by intersecting the visible box with the full
+        // image placement, so a slice is a stretched placement.
+        let full = gpui::size(visible.size.width / du, visible.size.height / dv);
+        let placement = gpui::Bounds::new(
+            gpui::point(visible.origin.x - full.width * u0, visible.origin.y - full.height * v0),
+            full,
+        );
+        window
+            .paint_image(visible, placement, corners(radii), image.clone(), 0, false)
+            .ok();
+    }
+}
+
+/// Paint until the matching `Unclip` (or the end), recursing for nested clips.
+fn paint_range(
+    ops: &[Op],
+    index: &mut usize,
+    origin: gpui::Point<gpui::Pixels>,
+    images: &HashMap<u64, Arc<gpui::RenderImage>>,
+    window: &mut gpui::Window,
+    cx: &mut gpui::App,
+) {
+    while *index < ops.len() {
+        let op = &ops[*index];
+        *index += 1;
+        match op {
+            Op::Rect { bounds, color, radii, border } => {
+                let (border_color, border_width) = border.unwrap_or((gpui::transparent_black(), 0.0));
+                window.paint_quad(gpui::quad(
+                    rect(origin, bounds),
+                    corners(radii),
+                    *color,
+                    gpui::px(border_width),
+                    border_color,
+                    gpui::BorderStyle::default(),
+                ));
+            }
+            Op::Image { .. } => {
+                let start = *index - 1;
+                if let Some((end, bounds)) = image_group(ops, start) {
+                    // One conservative bounds insertion also survives cached
+                    // scene replay. Coordinates, sampling and clipping stay
+                    // unchanged; disjointness makes tile sorting harmless.
+                    // Expand only the ordering envelope by a device pixel to
+                    // cover floating-point union/translation roundoff. This
+                    // does not change any image bounds or its content mask.
+                    let envelope = rect(origin, &bounds).dilate(gpui::px(1.0 / window.scale_factor()));
+                    window.paint_layer(envelope, |window| {
+                        for image in &ops[start..end] {
+                            paint_image_op(image, origin, images, window);
+                        }
+                    });
+                    *index = end;
+                } else {
+                    paint_image_op(op, origin, images, window);
+                }
+            }
+            Op::Text { x, y, text, size, color, font, line_height, align } => {
+                if text.is_empty() {
+                    continue;
+                }
+                let run = gpui::TextRun {
+                    len: text.len(),
+                    font: font.clone(),
+                    color: *color,
+                    background_color: None,
+                    underline: None,
+                    strikethrough: None,
+                };
+                let line = window
+                    .text_system()
+                    .shape_line(text.clone(), gpui::px(*size), &[run], None);
+                let (text_align, align_width) = match align {
+                    Some((width, align)) => (*align, Some(gpui::px(*width))),
+                    None => (gpui::TextAlign::Left, None),
+                };
+                let origin = gpui::point(origin.x + gpui::px(*x), origin.y + gpui::px(*y));
+                line.paint(origin, gpui::px(*line_height), text_align, align_width, window, cx)
+                    .ok();
+                crate::text::log_painted_text(text.clone());
+            }
+            Op::Fill { color, contours } => {
+                let mut builder = gpui::PathBuilder::fill();
+                let mut any = false;
+                for contour in contours {
+                    let mut points = contour.chunks_exact(2);
+                    let Some(first) = points.next() else { continue };
+                    builder.move_to(gpui::point(origin.x + gpui::px(first[0]), origin.y + gpui::px(first[1])));
+                    for point in points {
+                        builder.line_to(gpui::point(origin.x + gpui::px(point[0]), origin.y + gpui::px(point[1])));
+                    }
+                    builder.close();
+                    any = true;
+                }
+                if any {
+                    if let Ok(path) = builder.build() {
+                        window.paint_path(path, *color);
+                    }
+                }
+            }
+            Op::Stroke { color, width, points } => {
+                let mut builder = gpui::PathBuilder::stroke(gpui::px(*width));
+                let mut points = points.chunks_exact(2);
+                let Some(first) = points.next() else { continue };
+                builder.move_to(gpui::point(origin.x + gpui::px(first[0]), origin.y + gpui::px(first[1])));
+                for point in points {
+                    builder.line_to(gpui::point(origin.x + gpui::px(point[0]), origin.y + gpui::px(point[1])));
+                }
+                if let Ok(path) = builder.build() {
+                    window.paint_path(path, *color);
+                }
+            }
+            Op::Clip(bounds) => {
+                let mask = gpui::ContentMask { bounds: rect(origin, bounds) };
+                window.with_content_mask(Some(mask), |window| {
+                    paint_range(ops, index, origin, images, window, cx)
+                });
+            }
+            Op::Unclip => return,
+        }
+    }
+}
+
+// ── Element ──────────────────────────────────────────────────────────
+
+#[derive(Default)]
+pub struct CanvasElement {
+    source: String,
+    ops: Rc<Vec<Op>>,
+    painter: Option<gpui::Entity<CanvasPainter>>,
+}
+
+struct CanvasPainter {
+    ops: Rc<Vec<Op>>,
+    image_generation: u64,
+    images: Vec<(u64, usize)>,
+    scale: f32,
+}
+
+fn image_signature(ops: &[Op]) -> Vec<(u64, usize)> {
+    let store = PAINT_IMAGES.lock().unwrap();
+    ops.iter().filter_map(|op| match op {
+        Op::Image { key, .. } => Some((*key, store.images.get(key).map_or(0, |image| Arc::as_ptr(image) as usize))),
+        _ => None,
+    }).collect()
+}
+
+impl gpui::Render for CanvasPainter {
+    fn render(&mut self, _window: &mut gpui::Window, _cx: &mut gpui::Context<Self>) -> impl gpui::IntoElement {
+        use gpui::prelude::*;
+        let ops = self.ops.clone();
+        gpui::canvas(|_, _, _| (), move |bounds, _, window, cx| {
+            window.with_content_mask(Some(gpui::ContentMask { bounds }), |window| {
+                paint_ops(&ops, bounds.origin, window, cx)
+            })
+        }).absolute().size_full()
+    }
+}
+
+impl CustomElement for CanvasElement {
+    fn render(
+        &mut self,
+        ctx: CustomRenderContext,
+        window: &mut gpui::Window,
+        cx: &mut gpui::Context<crate::renderer::GpuixView>,
+    ) -> gpui::AnyElement {
+        use gpui::prelude::*;
+
+        let generation = IMAGE_GENERATION.load(Ordering::Acquire);
+        let scale = window.scale_factor();
+        let painter = self.painter.get_or_insert_with(|| cx.new(|_| CanvasPainter {
+            ops: self.ops.clone(), image_generation: generation, images: image_signature(&self.ops), scale,
+        }));
+        let changed = painter.update(cx, |painter, _cx| {
+            let commands_changed = !Rc::ptr_eq(&painter.ops, &self.ops);
+            let images = (commands_changed || painter.image_generation != generation).then(|| image_signature(&self.ops));
+            let images_changed = images.as_ref().is_some_and(|images| *images != painter.images);
+            painter.image_generation = generation;
+            if let Some(images) = images { painter.images = images; }
+            // Uploading a newly visible transcript word must not invalidate
+            // unchanged sidebar/composer lists that reference different images.
+            if commands_changed || images_changed || painter.scale != scale {
+                painter.ops = self.ops.clone();
+                painter.scale = scale;
+                return true;
+            }
+            false
+        });
+        // Only the noninteractive paint list is cached. The outer surface still
+        // owns current bounds, overlays, accessibility and event handlers.
+        // Paint changed commands uncached immediately. GPUI retains cached
+        // element state only when it is accessed in this frame, so this also
+        // drops the previous cached scene. Notifying here would schedule a
+        // redundant root draw after the changed ink was already painted.
+        // Text painting also feeds per-frame automation text collection.
+        // Keep that path live; rasterized original-painter lists can reuse ink.
+        let painter = if changed || self.ops.iter().any(|op| matches!(op, Op::Text { .. })) {
+            painter.clone().into_any_element()
+        } else {
+            painter.clone().cached(gpui::StyleRefinement::default().absolute().size_full()).into_any_element()
+        };
+        // Children (overlays) paint above the display list.
+        let mut surface = super::custom_surface(gpui::div().id(gpui::ElementId::Integer(ctx.id)), &ctx)
+            .child(painter);
+        for child in ctx.children {
+            surface = surface.child(child);
+        }
+        surface.into_any_element()
+    }
+
+    fn set_prop(&mut self, key: &str, value: serde_json::Value) {
+        if key == "commands" {
+            let source = match value { serde_json::Value::String(source) => source, _ => String::new() };
+            if source != self.source {
+                self.ops = Rc::new(parse(&source));
+                self.source = source;
+            }
+        }
+    }
+
+    fn supported_props(&self) -> &'static [&'static str] {
+        &["commands"]
+    }
+
+    fn supported_events(&self) -> &'static [&'static str] {
+        &["click", "mouseEnter", "mouseLeave"]
+    }
+
+    fn destroy(&mut self) {}
+}
+
+pub struct CanvasFactory;
+
+impl CustomElementFactory for CanvasFactory {
+    fn element_type(&self) -> &str {
+        "canvas"
+    }
+
+    fn create(&self, _id: u64) -> Box<dyn CustomElement> {
+        Box::new(CanvasElement::default())
+    }
+}
