[Desktop Entry]
Type=Application
TryExec=neoism
Exec=neoism %U
MimeType=x-scheme-handler/neoism;text/markdown;application/json;application/x-yaml;text/x-rust;text/x-python;application/javascript;text/x-go;text/x-c;text/x-c++;application/x-shellscript;application/toml;text/html;text/css;text/plain;application/x-ipynb+json;
Icon=neoism
Terminal=false
Categories=System;TerminalEmulator;Development;

Name=Neoism
GenericName=Terminal-first editor workspace
Comment=A hardware-accelerated terminal-first editor workspace
StartupWMClass=neoism
Actions=New;

[Desktop Action New]
Name=New Neoism Window
Exec=neoism --new-window
