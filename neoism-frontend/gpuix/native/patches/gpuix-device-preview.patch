+                mesh.triangle(std::array::from_fn(|index| Vertex { position:points[index],normal:[0.0,0.0,1.0],uv:uvs[index],material:2.0,display:options.display.number(),aspect:1.0 }));
+            }
+            return mesh;
+        }
+        match options.model {
+            Model::Pro => mesh.phone(0.641,1.34,Model::Pro,false,[0.0,1.0]),
+            Model::Max => mesh.phone(0.708,1.48,Model::Max,false,[0.0,1.0]),
+            Model::Duo => {
+                mesh.phone(0.91,1.30,Model::Duo,true,[0.0,0.5]);
+                mesh.transform_range(0,[-0.91,0.0,0.0],0.0,options.hinge*0.5);
+                // Offset the closing leaves around the hinge barrel: at PI their inner glass has a 0.02-unit air gap instead of intersecting.
+                let clearance=0.071*(options.hinge*0.5).sin();
+                for vertex in &mut mesh.vertices {vertex.position[0]-=clearance;}
+                let start=mesh.vertices.len(); mesh.phone(0.91,1.30,Model::Duo,false,[0.5,1.0]);
+                mesh.transform_range(start,[0.91,0.0,0.0],0.0,-options.hinge*0.5);
+                for vertex in &mut mesh.vertices[start..] {vertex.position[0]+=clearance;}
+                mesh.cylinder([0.0,0.0,0.0],0.049,1.26,1,5.0);
+                for y in [-1.1,-0.55,0.55,1.1] {mesh.cylinder([0.0,y,0.0],0.05,0.004,1,9.0);}
+                for vertex in &mut mesh.vertices {
+                    if !options.duo_book {
+                        vertex.position=[-vertex.position[1],vertex.position[0],vertex.position[2]];
+                        vertex.normal=[-vertex.normal[1],vertex.normal[0],vertex.normal[2]];
+                    }
+                    if vertex.material==2.0&&vertex.display==0.0 {vertex.uv=[vertex.uv[1],1.0-vertex.uv[0]];vertex.aspect=1.0/vertex.aspect;}
+                }
+            }
+            Model::Tablet => {
+                mesh.phone(1.095,1.43,Model::Tablet,false,[0.0,1.0]);
+                if options.keyboard {
+                    for vertex in &mut mesh.vertices {
+                        vertex.position=[-vertex.position[1],vertex.position[0],vertex.position[2]];
+                        vertex.normal=[-vertex.normal[1],vertex.normal[0],vertex.normal[2]];
+                        if vertex.material==2.0 {vertex.uv=[vertex.uv[1],1.0-vertex.uv[0]];vertex.aspect=1.0/vertex.aspect;}
+                    }
+                    mesh.transform_range(0,[0.0,0.24,-0.30],-0.24,0.0);
+                    mesh.bevel_box([0.0,-1.05,0.34],[1.52,0.035,0.99],0.025,13.0);
+                    mesh.bevel_box([0.0,-1.025,0.16],[1.43,0.024,0.64],0.02,3.0);
+                    let glyphs=[0b101101111101010,0b011101011101011,0b110001001001110,0b011101101101011,0b111001011001111,0b001001011001111,0b110101101001110,0b101101111101101,0b111010010010111,0b010101100100100,0b101011001011101,0b111001001001001];
+                    for row in 0..5 {for column in 0..14 {
+                        let shift=if row==2 {0.04} else if row==3 {0.065} else {0.0};
+                        let x=-1.31+column as f32*0.202+if column>0&&column<13 {shift} else {0.0};
+                        mesh.keycap(x,-0.37+row as f32*0.175,0.174,if row==0 {0.10} else {0.143},glyphs[(row*14+column)%glyphs.len()]);
+                    }}
+                    mesh.bevel_box([0.0,-0.982,0.57],[0.52,0.018,0.10],0.014,7.0);
+                    mesh.bevel_box([0.0,-0.986,1.00],[0.58,0.010,0.23],0.008,13.0);
+                    let start=mesh.vertices.len();mesh.rounded_volume([0.0,-0.34,-0.064],1.42,0.70,0.018,0.07,13.0);mesh.transform_range(start,[0.0,0.24,-0.30],-0.24,0.0);
+                    let start=mesh.vertices.len();mesh.rounded_volume([0.0,-0.58,-0.55],1.30,0.40,0.023,0.05,13.0);mesh.transform_range(start,[0.0,0.0,0.0],-0.25,0.0);
+                    mesh.cylinder([0.0,-0.94,-0.52],0.047,1.32,0,13.0);
+                }
+            }
+        }
+        if options.model!=Model::Duo&&!options.keyboard {
+            for vertex in &mut mesh.vertices {
+                let (position,normal,uv,swap)=match options.orientation {
+                    Orientation::Portrait=>(vertex.position,vertex.normal,vertex.uv,false),
+                    Orientation::PortraitUpsideDown=>([-vertex.position[0],-vertex.position[1],vertex.position[2]],[-vertex.normal[0],-vertex.normal[1],vertex.normal[2]],[1.0-vertex.uv[0],1.0-vertex.uv[1]],false),
+                    Orientation::LandscapeLeft=>([vertex.position[1],-vertex.position[0],vertex.position[2]],[vertex.normal[1],-vertex.normal[0],vertex.normal[2]],[1.0-vertex.uv[1],vertex.uv[0]],true),
+                    Orientation::LandscapeRight=>([-vertex.position[1],vertex.position[0],vertex.position[2]],[-vertex.normal[1],vertex.normal[0],vertex.normal[2]],[vertex.uv[1],1.0-vertex.uv[0]],true),
+                };
+                vertex.position=position;vertex.normal=normal;
+                if vertex.material==2.0 {vertex.uv=uv;if swap {vertex.aspect=1.0/vertex.aspect;}}
+            }
+        }
+        mesh
+    }
+    pub fn hit(&self, options:Options, position:[f32;2], size:[f32;2], source:[f32;2]) -> Option<[f32;2]> {
+        if options.flat { return contain([position[0]/size[0],position[1]/size[1]],size[0]/size[1],source); }
+        let origin=self.camera(options,size[0]/size[1]);
+        let direction=normalize([(position[0]*2.0-size[0])/size[1],-(position[1]*2.0-size[1])/size[1],-focal(options)]);
+        let mut nearest=f32::INFINITY; let mut hit=None;
+        for indices in self.indices.chunks_exact(3) {
+            let vertices=[self.vertices[indices[0] as usize],self.vertices[indices[1] as usize],self.vertices[indices[2] as usize]];
+            let a=world(vertices[0].position,options); let edge1=sub(world(vertices[1].position,options),a); let edge2=sub(world(vertices[2].position,options),a);
+            let perpendicular=cross(direction,edge2); let determinant=dot(edge1,perpendicular);
+            if determinant.abs()<0.0000001 { continue; }
+            let inverse=1.0/determinant; let delta=sub(origin,a); let u=dot(delta,perpendicular)*inverse;
+            let crossed=cross(delta,edge1); let v=dot(direction,crossed)*inverse; let distance=dot(edge2,crossed)*inverse;
+            if u<0.0||v<0.0||u+v>1.0||distance<0.01||distance>=nearest { continue; }
+            nearest=distance; hit=None;
+            if vertices[0].material==2.0 && vertices[0].display==options.display.number() {
+                let mut uv=std::array::from_fn(|axis| vertices[0].uv[axis]*(1.0-u-v)+vertices[1].uv[axis]*u+vertices[2].uv[axis]*v);
+                let mut aspect=vertices[0].aspect;
+                if options.model==Model::Duo&&options.duo_book&&options.display==Display::Inner&&source[0]>source[1] {uv=[1.0-uv[1],uv[0]];aspect=1.0/aspect;}
+                hit=contain(uv,aspect,source);
+            }
+        }
+        hit
+    }
+    pub fn facing(&self,options:Options) -> Display {
+        let origin=self.camera(options,1.0); let mut areas=[0.0;2];
+        for (index,indices) in self.indices.chunks_exact(3).enumerate() {
+            let a=self.vertices[indices[0] as usize]; if a.material!=2.0 {continue;}
+            if index%8!=0 {continue;}
+            let b=self.vertices[indices[1] as usize]; let c=self.vertices[indices[2] as usize];
+            let local_center=mul(add(add(a.position,b.position),c.position),1.0/3.0);
+            let center=world(local_center,options);
+            let candidate=Options {display:if a.display==0.0 {Display::Inner} else {Display::Cover},..options};
+            let Some(pixel)=project_camera(local_center,options,[512.0,512.0],origin) else {continue;};
+            if self.hit(candidate,pixel,[512.0,512.0],[a.aspect,1.0]).is_none() {continue;}
+            let area=dot(cross(sub(b.position,a.position),sub(c.position,a.position)),cross(sub(b.position,a.position),sub(c.position,a.position))).sqrt();
+            areas[a.display as usize]+=area*dot(world(a.normal,options),normalize(sub(origin,center))).max(0.0);
+        }
+        if areas[1]>areas[0] {Display::Cover} else {Display::Inner}
+    }
+}
+pub fn contain(uv:[f32;2], target_aspect:f32, source:[f32;2]) -> Option<[f32;2]> {
+    let source_aspect=source[0]/source[1]; let size=[(source_aspect/target_aspect).min(1.0),(target_aspect/source_aspect).min(1.0)];
+    let mapped=[(uv[0]-0.5)/size[0]+0.5,(uv[1]-0.5)/size[1]+0.5];
+    if mapped.iter().all(|value| *value>=0.0&&*value<=1.0) {Some(mapped)} else {None}
+}
