@@ -0,0 +1,126 @@
+//! Load the compositor's driver first without changing the process environment.
+//! Normal loader discovery remains the fallback for unsupported loaders, user
+//! overrides, unknown drivers and devices unable to present to this surface.
+use std::path::{Path, PathBuf};
+use anyhow::{Context, bail};
+use ash::vk;
+use crate::CompositorGpuHint;
+
+pub(crate) fn preferred_instance(hint: Option<CompositorGpuHint>) -> Option<wgpu::Instance> {
+    let hint = hint?;
+    if wgpu::InstanceFlags::default().intersects(wgpu::InstanceFlags::DEBUG | wgpu::InstanceFlags::VALIDATION | wgpu::InstanceFlags::GPU_BASED_VALIDATION) || user_driver_override(hint) {
+        return None;
+    }
+    let library = preferred_library(hint.vendor_id)?;
+    match create_instance(&library) {
+        Ok(instance) => {
+            log::info!("Initialized compositor Vulkan driver directly (vendor={:#06x})", hint.vendor_id);
+            Some(instance)
+        }
+        Err(error) => {
+            log::info!("Direct Vulkan driver loading unavailable ({error:#}); using normal discovery");
+            None
+        }
+    }
+}
+
+fn user_driver_override(hint: CompositorGpuHint) -> bool {
+    if ["VK_DRIVER_FILES", "VK_ICD_FILENAMES", "VK_ADD_DRIVER_FILES", "VK_LOADER_DRIVERS_SELECT",
+        "VK_LOADER_DRIVERS_DISABLE", "VK_INSTANCE_LAYERS", "VK_LAYER_PATH", "VK_ADD_LAYER_PATH",
+        "VK_LOADER_SETTINGS_PATH", "VK_LOADER_LAYERS_ENABLE", "VK_LOADER_LAYERS_DISABLE",
+        "GPUI_DISABLE_DIRECT_DRIVER_LOADING"].iter().any(|key| std::env::var_os(key).is_some()) {
+        return true;
+    }
+    if let Ok(device) = std::env::var("ZED_DEVICE_ID") {
+        let value = device.trim().trim_start_matches("0x");
+        if u32::from_str_radix(value, 16).ok() != Some(hint.device_id) { return true; }
+    }
+    // Keep older Neoism GPU-selection overrides on the ordinary path too.
+    std::env::var("NEOISM_VULKAN_DEVICE").is_ok_and(|v| !matches!(v.trim(), "" | "auto"))
+}
+
+fn library_vendor(path: &Path) -> Option<u32> {
+    let name = path.file_name()?.to_str()?;
+    if name.starts_with("libvulkan_radeon.so") { Some(0x1002) }
+    else if name.starts_with("libvulkan_intel.so") { Some(0x8086) }
+    else if name.starts_with("libGLX_nvidia.so") || name.starts_with("libvulkan_nvidia.so") { Some(0x10de) }
+    else { None }
+}
+
+fn preferred_library(vendor: u32) -> Option<PathBuf> {
+    let mut dirs = vec![PathBuf::from("/usr/share/vulkan/icd.d"), PathBuf::from("/usr/local/share/vulkan/icd.d"), PathBuf::from("/etc/vulkan/icd.d")];
+    for key in ["XDG_CONFIG_HOME", "XDG_DATA_HOME"] {
+        if let Some(path) = std::env::var_os(key) { dirs.push(PathBuf::from(path).join("vulkan/icd.d")); }
+    }
+    if let Some(home) = std::env::var_os("HOME") {
+        dirs.push(PathBuf::from(&home).join(".config/vulkan/icd.d"));
+        dirs.push(PathBuf::from(home).join(".local/share/vulkan/icd.d"));
+    }
+    for key in ["XDG_CONFIG_DIRS", "XDG_DATA_DIRS"] {
+        if let Some(paths) = std::env::var_os(key) { dirs.extend(std::env::split_paths(&paths).map(|p| p.join("vulkan/icd.d"))); }
+    }
+    let mut libraries = Vec::new();
+    for dir in dirs {
+        let Ok(entries) = std::fs::read_dir(&dir) else { continue; };
+        for entry in entries.flatten() {
+            let path = entry.path();
+            if path.extension().and_then(|s| s.to_str()) != Some("json") { continue; }
+            let Ok(bytes) = std::fs::read(&path) else { continue; };
+            let Ok(manifest) = serde_json::from_slice::<serde_json::Value>(&bytes) else { continue; };
+            let Some(library) = manifest["ICD"]["library_path"].as_str() else { continue; };
+            let mut library = PathBuf::from(library);
+            if library_vendor(&library) != Some(vendor) { continue; }
+            if library.is_relative() && library.components().count() > 1 { library = dir.join(library); }
+            if !libraries.contains(&library) { libraries.push(library); }
+        }
+    }
+    // Do not choose between multiple implementations of the same vendor.
+    (libraries.len() == 1).then(|| libraries.remove(0))
+}
+
+struct InstanceOwner {
+    raw: ash::Instance,
+    _driver: libloading::Library,
+    _loader: ash::Entry,
+}
+impl Drop for InstanceOwner {
+    fn drop(&mut self) {
+        // The HAL invokes this only after its last instance/device/surface
+        // reference disappears. Both libraries remain loaded through this call.
+        unsafe { self.raw.destroy_instance(None); }
+    }
+}
+
+fn create_instance(path: &Path) -> anyhow::Result<wgpu::Instance> {
+    // These are the same installed ICDs consumed by the system loader. Keep
+    // their function pointers alive in InstanceOwner until HAL teardown.
+    let driver = unsafe { libloading::Library::new(path) }.context("loading preferred ICD")?;
+    let gipa = unsafe { *driver.get::<vk::PFN_vkGetInstanceProcAddr>(b"vk_icdGetInstanceProcAddr\0")? };
+    let driver_entry = unsafe { ash::Entry::from_static_fn(ash::StaticFn { get_instance_proc_addr: gipa }) };
+    let loader = unsafe { ash::Entry::load() }?;
+    let version = unsafe { loader.try_enumerate_instance_version() }?.unwrap_or(vk::API_VERSION_1_0).min(vk::API_VERSION_1_3);
+    if version < vk::API_VERSION_1_1 { bail!("Vulkan loader is older than 1.1"); }
+
+    // Query only this ICD's extensions. Calling the loader's global extension
+    // query would initialize every installed driver before exclusive loading.
+    // All instance creation/dispatch still goes through the real system loader.
+    let mut functions = loader.fp_v1_0().clone();
+    functions.enumerate_instance_extension_properties = driver_entry.fp_v1_0().enumerate_instance_extension_properties;
+    let entry = ash::Entry::from_parts_1_1(loader.static_fn().clone(), functions, loader.fp_v1_1().clone());
+    let flags = wgpu::InstanceFlags::default();
+    let mut extensions = wgpu::hal::vulkan::Instance::desired_extensions(&entry, version, flags)?;
+    if !extensions.contains(&ash::khr::wayland_surface::NAME) { bail!("preferred driver has no Wayland surface support"); }
+    extensions.push(ash::lunarg::direct_driver_loading::NAME);
+    let pointers: Vec<_> = extensions.iter().map(|s| s.as_ptr()).collect();
+    let drivers = [vk::DirectDriverLoadingInfoLUNARG::default().pfn_get_instance_proc_addr(Some(gipa))];
+    let mut direct = vk::DirectDriverLoadingListLUNARG::default().mode(vk::DirectDriverLoadingModeLUNARG::EXCLUSIVE).drivers(&drivers);
+    let app = vk::ApplicationInfo::default().application_name(c"Neoism").engine_name(c"wgpu-hal").api_version(version);
+    let info = vk::InstanceCreateInfo::default().application_info(&app).enabled_extension_names(&pointers).push_next(&mut direct);
+    let raw = unsafe { entry.create_instance(&info, None) }.context("creating direct-driver instance")?;
+    let owner = InstanceOwner { raw: raw.clone(), _driver: driver, _loader: loader };
+    // Extensions are exactly desired_extensions(entry), plus direct loading;
+    // flags/API match creation. The drop callback owns the instance and both
+    // dynamic libraries, and is also safe if from_raw returns an error.
+    let hal = unsafe { wgpu::hal::vulkan::Instance::from_raw(entry, raw, version, 0, None, extensions, flags, Default::default(), false, Some(Box::new(move || drop(owner)))) }?;
+    Ok(unsafe { wgpu::Instance::from_hal::<wgpu::hal::api::Vulkan>(hal) })
+}
