+fn world(point:vec3<f32>) -> vec3<f32> {
+    let yaw=settings.viewport.z;let pitch=settings.viewport.w;
+    let tilted=vec3<f32>(point.x,cos(pitch)*point.y-sin(pitch)*point.z,sin(pitch)*point.y+cos(pitch)*point.z);
+    return vec3<f32>(cos(yaw)*tilted.x+sin(yaw)*tilted.z,tilted.y,-sin(yaw)*tilted.x+cos(yaw)*tilted.z);
+}
+@vertex fn vertex(input:Input) -> Varying {
