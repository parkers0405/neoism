     use super::*;
     use gpui::{MonochromeSprite, PolychromeSprite, Quad, Shadow, SubpixelSprite, Underline};
 
+    #[test]
+    fn scene_capture_preserves_rgba_colors_and_padded_rows() -> Result<()> {
+        let context = WgpuContext::new_offscreen()?;
+        for format in [wgpu::TextureFormat::Rgba8Unorm, wgpu::TextureFormat::Bgra8Unorm] {
+            let size = gpui::size(DevicePixels(65), DevicePixels(3));
+            let mut renderer = WgpuRenderer::new_offscreen(&context, size)?;
+            renderer.surface_config.format = format;
+            let resources = renderer.resources();
+            let pipelines = WgpuRenderer::create_pipelines(
+                &resources.device,
+                &renderer.adapter_info,
+                &resources.bind_group_layouts,
+                format,
+                renderer.surface_config.alpha_mode,
+                renderer.rendering_params.path_sample_count,
+                renderer.dual_source_blending,
+                renderer.uses_webgl_instance_data,
+            );
+            renderer.resources_mut().pipelines = pipelines;
+            let bounds = gpui::Bounds {
+                origin: gpui::point(gpui::ScaledPixels(0.), gpui::ScaledPixels(0.)),
+                size: gpui::size(gpui::ScaledPixels(65.), gpui::ScaledPixels(3.)),
+            };
+            let mut scene = Scene::default();
+            scene.insert_primitive(Quad {
+                bounds,
+                content_mask: gpui::ContentMask { bounds },
+                background: gpui::rgb(0xff0000).into(),
+                ..Default::default()
+            });
+            scene.finish();
+            assert!(renderer.resources().readback.is_none());
+            for _ in 0..2 {
+                let image = renderer.render_scene_to_pixels(&scene)?;
+                assert_eq!(image.dimensions(), (65, 3));
+                for pixel in image.pixels() {
+                    assert_eq!(pixel.0, [255, 0, 0, 255], "{format:?}");
+                }
+                assert_eq!(renderer.viewport_size(), size);
+            }
+        }
+        Ok(())
+    }
